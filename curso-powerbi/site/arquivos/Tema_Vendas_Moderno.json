{
  "name": "Vendas Moderno",
  "dataColors": [
    "#4F46E5",
    "#06B6D4",
    "#F59E0B",
    "#10B981",
    "#EC4899",
    "#8B5CF6",
    "#EF4444",
    "#64748B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1E293B",
  "tableAccent": "#4F46E5",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1E293B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#475569"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#0F172A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1E293B"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "transparency": 80
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 26,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ]
      }
    }
  }
}